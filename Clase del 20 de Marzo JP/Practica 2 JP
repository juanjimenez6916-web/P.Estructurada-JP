#include <stdio.h>
#include <stdlib.h>
#include <string.h>
int main()
{
    int j,i;
    char nombre[10];
    char tablero[5][5];
    FILE *archivo;
    archivo = fopen("tablero.txt", "w");
    fprintf(archivo,"Juan Pablo\n");
    for (i=0; i<5; i++)
    {
        for(j=0; j<5; j++)
        {
            tablero[i][j] = '~';
            tablero[1][2]= 'B';
            tablero[3][4]= 'X';
            tablero[2][1]= 'O';
            printf("%c", tablero[i][j]);
        }
        printf("\n");
    }

    printf("Ingrese un nombre: \n");
    fgets(nombre,sizeof(nombre),stdin);
    nombre[strcspn(nombre, "\n")] = '\0';
    printf("El nombre es: %s\n",nombre);
    fprintf(archivo,"%c",nombre);
    fprintf(archivo,"\n");

    for (i=0; i<5; i++)
    {

        for(j=0; j<5; j++)
        {
            fprintf(archivo, "%c",tablero[i][j]);
        }
        fprintf(archivo,"\n");
    }
    fprintf(archivo,"Juan Pablo\n");
    fclose(archivo);


    return 0;
}
