#include <stdio.h>
#include <stdlib.h>

void capturar(int v[], int n) {
    int i;
    for (i = 0; i < n; i++) {
        printf("Ingresa el valor %d: ", i + 1);
        scanf("%d", &v[i]);
    }
}

void mostrar(int v[], int n) {
    int i;
    for(i = 0; i < n; i++) {
        printf("%d ", v[i]);
    }
    printf("\n");
}

int filtrar(int origen[], int destino[], int n) {
    int i;
    int contador = 0;

    for(i = 0; i < n; i++) {
        if(origen[i] % 2 != 0) {
            destino[contador] = origen[i];
            contador++;
        }
    }
    return contador;
}

void guardarArchivo(int v[], int n) {
    FILE *f;
    int i;

    f = fopen("resultado.txt", "w");

    if (f == NULL) {
        printf("Error al crear el archivo.\n");
        return;
    }

    for(i = 0; i < n; i++) {
        fprintf(f, "%d", v[i]);
    }

    fclose(f);
}

int main() {
    int original[6];
    int filtrado[6];
    int cf;

    printf("--- Captura de datos ---\n");
    capturar(original, 6);

    printf("\narreglo original\n");
    mostrar(original, 6);

    cf = filtrar(original, filtrado, 6);

    printf("arreglo filtrado\n");
    mostrar(filtrado, cf);

    guardarArchivo(filtrado, cf);
    printf("\n[El resultado ha sido guardado exitosamente en resultado.txt]\n");

    return 0;
}
